 	public void deleteById(Integer id) {
 	    CampAreaBean campArea = campAreaRepo.findById(id)
 	        .orElseThrow(() -> new RuntimeException("找不到營地"));
 
 	    // 多對多解除關聯
 	    if (campArea.getFacilities() != null) campArea.getFacilities().clear();
 	    if (campArea.getWifis() != null) campArea.getWifis().clear();
 	    if (campArea.getBathrooms() != null) campArea.getBathrooms().clear();
 	    if (campArea.getParkings() != null) campArea.getParkings().clear();
 	    if (campArea.getPetPolicies() != null) campArea.getPetPolicies().clear();
 	    if (campArea.getFeatures() != null) campArea.getFeatures().clear();
 
 	    // 一對多解除關聯
 	    if (campArea.getCampAreaImages() != null) {
 	        campArea.getCampAreaImages().forEach(img -> img.setCampArea(null));
 	        campArea.getCampAreaImages().clear();
 	    }
 
 	    if (campArea.getCampSites() != null) {
 	        campArea.getCampSites().forEach(site -> site.setCampArea(null));
 	        campArea.getCampSites().clear();
 	    }
 
 	    if (campArea.getOffWeekdays() != null) {
 	        campArea.getOffWeekdays().forEach(off -> off.setCampArea(null));
 	        campArea.getOffWeekdays().clear();
 	    }
 
 	    if (campArea.getOffDays() != null) {
 	        campArea.getOffDays().forEach(off -> off.setCampArea(null));
 	        campArea.getOffDays().clear();
 	    }
 
 	    campAreaRepo.delete(campArea); // 使用 delete 而非 deleteById
 	}
 
 
